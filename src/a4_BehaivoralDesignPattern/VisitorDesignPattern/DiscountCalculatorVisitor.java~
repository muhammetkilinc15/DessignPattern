package a4_BehaivoralDesignPattern.VisitorDesignPattern;

public class DiscountCalculatorVisitor implements ProductVisitor {
    
    @Override
    public void visit(Book book) {
        if (book.getPrice() > 30) {
            double discountAmount = book.getPrice() * 0.05; // 5% discount
            System.out.printf("Book: %s - Discount: $%.2f\n", book.getTitle(), discountAmount);
        }else{
            System.out.printf("Book: %s - Discount $0.0 (No discount)\n", book.getTitle());
        }
    }

    @Override
    public void visit(Electronics electronics) {
        System.out.printf("Electronics: %s - Discount: $0.0 (No discount)\n", electronics.getName());
    }

    @Override
    public void visit(Clothing clothing) {
        if (clothing.getPrice() > 200) {
            double discountAmount = clothing.getPrice() * 0.15; // 15% discount
            System.out.printf("Clothing: %s - Discount: $%.2f\n", clothing.getBrand(), discountAmount);
        }else{
            System.out.printf("Clothing: %s - Discount: $0.0 (No discount)\n", clothing.getBrand());
        }
    }
}
